generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Empresa / Organización (Multi-Tenant)
model Company {
  id                     String       @id @default(uuid())
  slug                   String       @unique
  name                   String
  adminEmail             String
  adminPassword          String       @default("admin123")
  status                 String       @default("active")
  employeeCountExpected  Int          @default(25)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  departments            Department[]
  employees              Employee[]
  hrRequests             HRRequest[]
  hrActions              HRAction[]

  @@map("companies")
}

// 2. Dependencias / Oficinas 3D (Estilo Roblox)
model Department {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?  @db.Text
  leaderName  String?
  leaderRole  String?
  avatarUrl   String?
  color       String   @default("#3B82F6")
  posX        Float    @default(0)
  posZ        Float    @default(0)
  profile     String?  @default("gerencia")
  furniture   String?  @db.Text
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  progressRecords OnboardingProgress[]

  @@map("departments")
}

// 3. Funcionarios / Empleados Registrados
model Employee {
  id           String       @id @default(uuid())
  companyId    String
  departmentId String?
  name         String
  email        String
  password     String       @default("123456")
  role         String       @default("Funcionario")
  status             String       @default("ACTIVE") // ACTIVE, VACATION, ON_LEAVE, SUSPENDED, TERMINATED
  terminationReason  String?      @db.Text
  terminationDate    DateTime?
  color              String       @default("#3B82F6")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  progress           OnboardingProgress[]
  hrRequests         HRRequest[]
  hrActions          HRAction[]

  @@unique([companyId, email])
  @@map("employees")
}

// 4. Solicitudes Formales de RRHH (Trámites de Vida Real)
model HRRequest {
  id           String    @id @default(uuid())
  radicado     String    @unique
  companyId    String
  employeeId   String
  type         String    // PERMISO, VACACIONES, INCAPACIDAD, DESCARGOS, OTRO
  title        String
  reason       String    @db.Text
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  adminNotes   String?   @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hr_requests")
}

// 5. Acciones Disciplinarias y Legales de RRHH (Despidos, Memorandos, Suspensiones)
model HRAction {
  id            String    @id @default(uuid())
  companyId     String
  employeeId    String
  type          String    // DESPIDO, MEMORANDO, SUSPENSION, FELICITACION
  title         String
  description   String    @db.Text
  effectiveDate DateTime  @default(now())
  createdBy     String    @default("Recursos Humanos")
  createdAt     DateTime  @default(now())

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hr_actions")
}

// 4. Progreso y Misiones de Inducción
model OnboardingProgress {
  id           String     @id @default(uuid())
  employeeId   String
  departmentId String
  completedAt  DateTime   @default(now())

  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, departmentId])
  @@map("onboarding_progress")
}

// 5. Super Administrador de la Plataforma SaaS
model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Super Admin")
  createdAt DateTime @default(now())

  @@map("super_admins")
}
